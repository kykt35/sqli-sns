<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | ひとこと</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<a class="skip-link" href="#main">本文へ移動</a>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="/"><span class="brand-icon" aria-hidden="true">h.</span>ひとこと</a>
    <p class="brand-caption">日々の、小さな記録。</p>
    <nav aria-label="メインナビゲーション">
      <a class="nav-link" href="/">タイムライン <span aria-hidden="true">↗</span></a>
      <a class="nav-link" href="/search">投稿を検索 <span aria-hidden="true">⌕</span></a>
      <% if (user) { %>
        <a class="button" href="/posts/new">＋ 投稿する</a>
        <p class="signed-in">ログイン中<br><strong>@<%= user.username %></strong></p>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet-button" type="submit">ログアウト</button></form>
      <% } else { %>
        <a class="nav-link" href="/login">ログイン <span aria-hidden="true">→</span></a>
        <a class="button secondary" href="/register">アカウントを作成</a>
      <% } %>
    </nav>
    <p class="sidebar-note">思いついたこと。<br>今日の発見。<br>あなたの言葉で、ひとこと。</p>
  </aside>
  <main id="main" class="main">
