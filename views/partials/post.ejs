<article class="post-card">
  <div class="post-meta">
    <a class="post-author" href="/users/<%= post.user_id %>"><span class="avatar" aria-hidden="true"><%= post.username.slice(0,1).toUpperCase() %></span><span><strong>@<%= post.username %></strong><span class="post-date"><%= new Date(post.created_at).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span></span></a>
    <span class="visibility <%= post.is_public ? '' : 'private' %>"><%= post.is_public ? '公開' : '非公開' %></span>
  </div>
  <p class="post-body"><%= post.body %></p>
  <div class="post-bottom"><a href="/posts/<%= post.id %>">投稿 #<%= post.id %> <span aria-hidden="true">↗</span></a><% if (user && user.id === post.user_id) { %><a href="/posts/<%= post.id %>/edit">編集する</a><% } %></div>
</article>
