<%- include('partials/header') %>
<header class="page-heading"><div><p class="eyebrow">YOUR EVERYDAY NOTES</p><h1>ひとこと、残そう。</h1><p class="intro">日常の発見や思いを、気軽に。</p></div><% if (user) { %><a class="button" href="/posts/new">＋ 投稿する</a><% } %></header>
<form class="search-form" method="get" action="/search" role="search"><label class="sr-only" for="q">投稿を検索</label><input id="q" name="q" placeholder="気になる言葉を探す" maxlength="200"><button type="submit" class="button secondary">検索</button></form>
<div class="section-heading"><h2>みんなの投稿</h2><span>新しい順・最大50件</span></div>
<% if (!posts.length) { %><div class="empty"><h2>まだ投稿がありません</h2><p>最初のひとことを残してみませんか。</p></div><% } %>
<div class="post-list"><% for (const post of posts) { %><%- include('partials/post', { post }) %><% } %></div>
<%- include('partials/footer') %>
