APP_MODE=local
HOST=127.0.0.1
PORT=3000
LOCAL_PORT=3001
MAX_POSTS=1000
MAX_USERS=100
SESSION_TTL_MINUTES=240
# Public mode requires all four values below. Generate your own secrets.
SESSION_SECRET=
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Exact IP or CIDR of the HTTPS reverse proxy; comma-separated. No wildcard.
TRUST_PROXY=
